{
  "name": "lighthouse-badges",
  "version": "1.0.0",
  "description": "Generate Lighthouse score badges, JSON, or SVG using local Lighthouse",
  "type": "module",
  "bin": {
    "lighthouse-badges": "./dist/lighthouse-badges.js"
  },
  "scripts": {
    "prepare": "bun run build",
    "prepack": "bun run build",
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "biome check src/ tests/",
    "test": "vitest",
    "start": "node ./dist/lighthouse-badges.js",
    "prepublishOnly": "bun run build",
    "act": "act -l",
    "act:audit": "act -j audit",
    "act:build": "act -j build",
    "act:lint": "act -j lint",
    "act:test": "act -j test"
  },
  "keywords": [
    "lighthouse",
    "badges",
    "pagespeed",
    "performance",
    "accessibility",
    "seo"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "@opentelemetry/core": ">=2.8.0"
  }
}

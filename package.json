{
  "name": "@hidao/lighthouse-badges",
  "version": "1.0.0",
  "description": "Generate Lighthouse score badges, JSON, or SVG using local Lighthouse",
  "type": "module",
  "bin": {
    "lighthouse-badges": "./bin/lighthouse-badges.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hidao80/lighthouse-badges.git"
  },
  "homepage": "https://github.com/hidao80/lighthouse-badges#readme",
  "bugs": {
    "url": "https://github.com/hidao80/lighthouse-badges/issues"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "biome check src/ tests/",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "node ./bin/lighthouse-badges.js",
    "prepublishOnly": "bun run build",
    "act": "act -l",
    "act:audit": "act -j audit",
    "act:build": "act -j build",
    "act:lint": "act -j lint",
    "act:test": "act -j test"
  },
  "keywords": [
    "lighthouse",
    "badges",
    "pagespeed",
    "performance",
    "accessibility",
    "seo"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19"
  },
  "files": [
    "bin"
  ],
  "dependencies": {
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "@opentelemetry/core": ">=2.8.0"
  }
}
